{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nurok": {
      "type": "streamable-http",
      "url": "https://mcp.nurok.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "nurok-chatgpt-prod",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": ["kb:read"]
          }
        }
      }
    }
  }
}
